# Compiled binaries (Linux has no extension, so list explicitly)
main
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.bin

# Object and compiled files
*.o
*.a
*.d

# Build directories
build/
Debug/
Release/
.build/
cmake-build-debug/
cmake-build-release/

# Go
*.test
vendor/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Eclipse / STM32CubeIDE workspace metadata
.metadata/
.settings/
*.pdom
*.snap
*.ide.log*

# Debug launch configs — hardcode absolute paths, regenerated on first Debug run
*.launch
*.elf
*.map
*.list

# STM32CubeIDE per-project generated files (MCU-pinned, regenerated on project creation)
*.ld
*.s
Startup/

# Project-specific
tsl/

# TLS certs / private keys — never commit
*.pem
*.key
tls/
RemoteSystemsTempFiles/

# Purchased books — never commit
lets_go_further/lets-go-further.html/
Lets_Go/lets-go-professional-package.html/
